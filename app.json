{
  "expo": {
    "name": "Pripriya Nursery",
    "slug": "pripriya-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/appIcon.png",
    "scheme": "pripriyaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pripriya.nursery"
    },
    "android": {
      "package": "com.pripriya.nursery",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/appIcon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "notification": {
        "icon": "./assets/images/appIcon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/appIcon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/appIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#34A853",
          "dark": {
            "backgroundColor": "#34A853"
          }
        }
      ],
      "./plugins/withRazorpayQueries.js",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}